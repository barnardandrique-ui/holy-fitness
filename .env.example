# Copy this file to .env for local development. In production, add these in
# Vercel -> your project -> Settings -> Environment Variables. Never commit .env.

# REQUIRED — a long random string used to sign login cookies.
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=replace-this-with-a-long-random-string

# User data lives in Vercel KV (Upstash Redis). Create it in Vercel -> Storage with the
# prefix KV and Vercel adds KV_REST_API_URL / KV_REST_API_TOKEN for you.

# OPTIONAL — only needed for "Forgot password" emails (https://resend.com, free tier).
# Until you verify your own domain in Resend, it only delivers to the email address
# you registered with, so verify a domain before real users need password resets.
RESEND_API_KEY=
EMAIL_FROM=Holy Fitness <noreply@yourdomain.com>
# APP_URL is optional on Vercel (it falls back to your production URL).
APP_URL=

# OPTIONAL - reminder notifications (web push). Create the keys with:  node scripts/generate-vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# A password for the scheduler that calls /api/cron/remind every ~15 minutes (cron-job.org is free).
CRON_SECRET=
