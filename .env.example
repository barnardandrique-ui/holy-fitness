# Copy this file to .env, fill in real values, and never commit .env itself.

# A long, random, secret string used to sign login session cookies.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=replace-this-with-a-long-random-string

# Note: no Anthropic / AI API key is needed any more. Plans are generated by the
# built-in rule-based planner in lib/planner, which is free and instant.
#
# User accounts are stored in Vercel KV. When you create a KV database in your
# Vercel project's Storage tab, Vercel adds its connection variables (KV_REST_API_URL,
# KV_REST_API_TOKEN, ...) to the project automatically.
